# =============================================================================
# Revenue Leak Radar — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- PostgreSQL (Docker) ---
POSTGRES_USER=rlr_user
POSTGRES_PASSWORD=rlr_password
POSTGRES_DB=revenue_leak_radar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rlr_user:rlr_password@localhost:5432/revenue_leak_radar

# --- Redis (optional) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-secret-key-in-production-minimum-32-chars

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# AI Providers — Add at least ONE key. System auto-selects best available.
# Priority: Gemini → Groq → OpenRouter
# =============================================================================

# --- Google Gemini (Primary) ---
# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model choices: gemini-1.5-flash (fastest/free), gemini-1.5-pro (smarter)
GEMINI_MODEL=gemini-1.5-flash

# --- Groq (Secondary — very fast free tier) ---
# Free tier: https://console.groq.com
GROQ_API_KEY=

# Model choices: llama-3.1-8b-instant (fast), mixtral-8x7b-32768 (smarter)
GROQ_MODEL=llama-3.1-8b-instant

# --- OpenRouter (Tertiary) ---
# Free tier: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free model: meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- AI Behavior ---
# Override auto-selection: gemini | groq | openrouter | mock
PREFERRED_AI_PROVIDER=

# Use mock AI responses (no API key needed, great for offline dev)
AI_MOCK_MODE=false

# Max tokens for AI responses
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.1

# =============================================================================
# pgAdmin (optional — access at http://localhost:5050)
# =============================================================================
PGADMIN_EMAIL=admin@rlr.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# =============================================================================
# Frontend
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Revenue Leak Radar
NEXT_PUBLIC_APP_VERSION=0.1.0
